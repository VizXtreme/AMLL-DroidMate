<?xml version="1.0" encoding="UTF-8"?>
<!--
  ~ Android Lint 检查配置文件
  ~ 
  ~ Lint 是 Android Studio 的静态代码分析工具，可以检测潜在的问题：
  ~ - 性能优化
  ~ - 内存泄漏
  ~ - 安全性问题
  ~ - 国际化
  ~ - 代码规范
  ~ 
  ~ **配置策略**：
  ~ - 仅禁用确实不需要的检查
  ~ - 保持其他检查启用以捕获潜在问题
  ~ - 根据项目实际情况调整严重性级别
  -->
<lint>
    <!-- 忽略翻译检查：应用不需要强制多语言支持 -->
    <issue id="MissingTranslation" severity="ignore" />
    <issue id="ExtraTranslation" severity="ignore" />
</lint>
