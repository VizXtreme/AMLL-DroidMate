<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ 完整备份规则配置
  ~ 
  ~ Android Auto Backup 功能允许用户数据自动备份到 Google Drive。
  ~ 这个文件定义了哪些数据需要备份，哪些数据应该排除。
  ~ 
  ~ **备份策略**：
  ~ - 默认备份所有文件数据
  ~ - 排除缓存目录（节省空间，避免备份临时文件）
  ~ - 排除系统偏好设置（避免冲突）
  ~ - 排除 Google Analytics 偏好设置
  ~ 
  ~ **域类型说明**：
  ~ - file: 内部存储文件
  ~ - database: SQLite 数据库
  ~ - sharedpref: SharedPreferences 文件
  ~ 
  ~ @see https://developer.android.com/guide/topics/data/autobackup
  -->
<full-backup-content>
    <!-- 包含所有文件数据（默认备份） -->
    <include domain="file" path="." />
    
    <!-- 排除缓存目录（不需要备份临时文件） -->
    <exclude domain="file" path="cache" />
    <exclude domain="file" path="code_cache" />
    
    <!-- 排除无需备份的目录 -->
    <exclude domain="file" path="no_backup" />
    
    <!-- 排除系统级偏好设置（避免与应用逻辑冲突） -->
    <exclude domain="database" path="system_prefs" />
    
    <!-- 排除 Google Analytics 的偏好设置（隐私考虑） -->
    <exclude domain="sharedpref" path="com.google.android.gms.measurement.prefs" />
</full-backup-content>
