<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ 数据提取规则配置
  ~ 
  ~ Android 12 (API 31) 引入了数据提取功能，允许用户通过 USB 或 ADB
  > 将应用数据传输到电脑。这个文件定义了允许明文传输的网络域名。
  ~ 
  ~ **安全说明**：
  ~ - cleartextTrafficPermitted="true": 允许 HTTP 明文传输（仅用于数据提取）
  ~ - 仅限特定的可信域名，降低安全风险
  ~ 
  ~ **允许的域名**：
  ~ 2. music.163.com - 网易云音乐 API
  ~ 3. y.qq.com - QQ 音乐 API
  ~ 
  ~ **为什么需要这些规则？**：
  ~ Android 9+ 默认禁止明文 HTTP 流量，但数据提取时可能需要
  ~ 访问这些域名来获取歌词元数据，因此特别授权。
  ~ 
  ~ @see https://developer.android.com/about/versions/12/behavior-changes-12#cleartext-extraction
  -->
<data-extraction-rules>
    <!-- 域名配置：允许明文流量用于数据提取 -->
    <domain-config cleartextTrafficPermitted="true">
        
        <!-- 网易云音乐 API（支持子域名） -->
        <domain includeSubdomains="true">music.163.com</domain>
        
        <!-- QQ 音乐 API（支持子域名） -->
        <domain includeSubdomains="true">y.qq.com</domain>
    </domain-config>
</data-extraction-rules>
